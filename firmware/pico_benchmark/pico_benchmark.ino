// Benchmark firmware for the Raspberry Pi Pico (RP2040).
//
// Purpose (R7, "not oversizing the device"): run the SAME int8 model as the
// ESP32-S3 on a more limited board and measure the same resources, so the
// two can be compared. The Pico is not part of the field node.
//
// The benchmark and VECTOR need no sensor, so the Pico can run them while the
// ESP32-S3 keeps the sensors. The same BME280 or INA219 is never connected to
// both boards at once: they are moved to the Pico only to measure its power
// or to use TEST and SAMPLE (docs/hardware_setup.md, section 10).
//
// Serial commands (one per line, 115200 baud, USB port of the Pico):
//   STATUS      board, model, sensor and power meter state
//   TEST        check the sensor chip ID (0x60 BME280, 0x58 BMP280)
//   SAMPLE      read the BME280 once and print the values
//   BENCHMARK   time BENCHMARK_RUNS inferences and report resources (R7),
//               including power if an INA219 is connected
//   LASTBENCH   print the last benchmark report saved in the flash
//   VECTOR a,b,c,...  run the model on one already-quantized int8 input and
//               print the raw int8 output (used by ml/validate_on_device.py)
//   HELP        list the commands
//
// Report lines use the same names as firmware/inference, so the two
// benchmark reports can be put side by side.

#include <Wire.h>
#include <LittleFS.h>
#include <Adafruit_BME280.h>
#include <Adafruit_INA219.h>

// Same TensorFlow Lite Micro library as the ESP32-S3, so the comparison
// measures the boards and not two different libraries. On the RP2040 core it
// needs the extra compiler option "-include stdint.h": see firmware/README.md.
#include <Chirale_TensorFlowLite.h>
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"

#include "config.h"
#include "model_data.h"  // generated by ml/convert_tflite.py

// End of the program in the flash, defined by the linker script of the
// RP2040 core. The flash starts at address 0x10000000 (XIP base).
extern "C" uint8_t __flash_binary_end;
const uint32_t FLASH_START_ADDRESS = 0x10000000;

const uint8_t CHIP_ID_REGISTER = 0xD0;
const uint8_t CHIP_ID_BME280 = 0x60;
const uint8_t CHIP_ID_BMP280 = 0x58;

Adafruit_BME280 bme;
bool sensorReady = false;
Adafruit_INA219 ina219(INA219_I2C_ADDRESS);
bool powerMeterReady = false;
bool storageReady = false;

alignas(16) uint8_t tensorArena[TENSOR_ARENA_BYTES];
tflite::MicroInterpreter *interpreter = nullptr;
TfLiteTensor *inputTensor = nullptr;
TfLiteTensor *outputTensor = nullptr;
bool modelReady = false;

String commandLine = "";
String benchmarkReport = "";

// --------------------------------------------------------------- sensor ----

uint8_t readChipId() {
  Wire.beginTransmission(BME280_I2C_ADDRESS);
  Wire.write(CHIP_ID_REGISTER);
  if (Wire.endTransmission() != 0) {
    return 0;
  }
  Wire.requestFrom(BME280_I2C_ADDRESS, (uint8_t)1);
  return Wire.available() < 1 ? 0 : Wire.read();
}

bool testSensor() {
  uint8_t chipId = readChipId();
  Serial.print("# TEST chip ID at 0x");
  Serial.print(BME280_I2C_ADDRESS, HEX);
  Serial.print(": 0x");
  Serial.println(chipId, HEX);
  if (chipId == CHIP_ID_BME280) {
    Serial.println("# TEST OK: the sensor is a BME280");
    return true;
  }
  if (chipId == CHIP_ID_BMP280) {
    Serial.println("# TEST FAIL: the sensor is a BMP280. It has NO humidity.");
  } else if (chipId == 0) {
    Serial.println("# TEST FAIL: no sensor answers. Check the wiring.");
  } else {
    Serial.println("# TEST FAIL: unknown chip. A BME280 must answer 0x60.");
  }
  return false;
}

void startSensor() {
  sensorReady = false;
  if (readChipId() != CHIP_ID_BME280 || !bme.begin(BME280_I2C_ADDRESS, &Wire)) {
    return;
  }
  // Same settings as the ESP32-S3 firmware
  bme.setSampling(Adafruit_BME280::MODE_FORCED,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::SAMPLING_X1,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::FILTER_OFF);
  sensorReady = true;
}

void printSample() {
  if (!sensorReady) {
    startSensor();
  }
  if (!sensorReady || !bme.takeForcedMeasurement()) {
    Serial.println("# SAMPLE failed: sensor not ready");
    return;
  }
  Serial.print("SAMPLE,");
  Serial.print(bme.readTemperature(), 2);
  Serial.print(",");
  Serial.print(bme.readHumidity(), 2);
  Serial.print(",");
  Serial.println(bme.readPressure() / 100.0f, 2);  // Pa -> hPa
}

// ---------------------------------------------------------------- model ----

void startModel() {
  const tflite::Model *model = tflite::GetModel(g_model_data);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.println("# ERROR: model schema version not supported by the library");
    return;
  }
  // Same operations as the ESP32-S3: dense layers and softmax
  static tflite::MicroMutableOpResolver<2> resolver;
  resolver.AddFullyConnected();
  resolver.AddSoftmax();

  static tflite::MicroInterpreter staticInterpreter(
      model, resolver, tensorArena, TENSOR_ARENA_BYTES);
  interpreter = &staticInterpreter;
  if (interpreter->AllocateTensors() != kTfLiteOk) {
    Serial.println("# ERROR: AllocateTensors failed (tensor arena too small?)");
    return;
  }
  inputTensor = interpreter->input(0);
  outputTensor = interpreter->output(0);
  if (inputTensor->type != kTfLiteInt8 || outputTensor->type != kTfLiteInt8 ||
      inputTensor->bytes != MODEL_NUM_INPUTS || outputTensor->bytes != MODEL_NUM_CLASSES) {
    Serial.println("# ERROR: the model does not match model_data.h constants");
    return;
  }
  modelReady = true;
}

// Reads the next number of a text like "1,-2,3". Returns false at the end.
bool nextNumber(const char *&position, long &value) {
  while (*position == ' ' || *position == ',') {
    position++;
  }
  if (*position == '\0') {
    return false;
  }
  char *end;
  value = strtol(position, &end, 10);
  if (end == position) {
    return false;
  }
  position = end;
  return true;
}

// VECTOR a,b,c,...  -> RESULT x,y,...   (raw int8 values, no preprocessing)
void runVector(const String &values) {
  if (!modelReady) {
    Serial.println("# VECTOR skipped: model not ready");
    return;
  }
  const char *position = values.c_str();
  for (int i = 0; i < MODEL_NUM_INPUTS; i++) {
    long value;
    if (!nextNumber(position, value)) {
      Serial.println("# ERROR: VECTOR has too few values");
      return;
    }
    inputTensor->data.int8[i] = (int8_t)value;
  }
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  Serial.print("RESULT");
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    Serial.print(c == 0 ? " " : ",");
    Serial.print(outputTensor->data.int8[c]);
  }
  Serial.println();
}

// ------------------------------------------------------------ benchmark ----

void report(const String &line) {
  Serial.println(line);
  benchmarkReport += line + "\n";
}

void reportValue(const char *name, double value, int decimals) {
  report(String("BENCHMARK,") + name + "," + String(value, decimals));
}

void reportPercent(const char *name, unsigned long used, unsigned long total) {
  report(String("BENCHMARK,") + name + "," + String(used) + "," + String(total) +
         "," + String(100.0f * used / total, 2));
}

// Average power at the supply input, idle or running inferences without
// pause. Includes the losses of the voltage regulator of the board.
void measurePower(bool runInferences, float &currentMa, float &powerMw, float &busVoltageV) {
  currentMa = powerMw = busVoltageV = 0;
  for (int i = 0; i < POWER_SAMPLES; i++) {
    unsigned long start = millis();
    while (millis() - start < POWER_SAMPLE_PERIOD_MS) {
      if (runInferences) {
        interpreter->Invoke();
      } else {
        delay(1);
      }
    }
    currentMa += ina219.getCurrent_mA();
    powerMw += ina219.getPower_mW();
    busVoltageV += ina219.getBusVoltage_V();
  }
  currentMa /= POWER_SAMPLES;
  powerMw /= POWER_SAMPLES;
  busVoltageV /= POWER_SAMPLES;
}

void runBenchmark() {
  if (!modelReady) {
    Serial.println("# BENCHMARK skipped: model not ready");
    return;
  }
  benchmarkReport = "";
  double sum = 0, sumSquares = 0, cycleSum = 0;
  for (int i = 0; i < BENCHMARK_RUNS; i++) {
    // CPU cycles counted by the RP2040 core (64-bit counter)
    uint64_t startCycles = rp2040.getCycleCount64();
    unsigned long start = micros();
    interpreter->Invoke();
    double ms = (micros() - start) / 1000.0;
    cycleSum += (double)(rp2040.getCycleCount64() - startCycles);
    sum += ms;
    sumSquares += ms * ms;
  }
  double mean = sum / BENCHMARK_RUNS;
  double variance = (sumSquares - BENCHMARK_RUNS * mean * mean) / (BENCHMARK_RUNS - 1);
  double deviation = variance > 0 ? sqrt(variance) : 0;

  report("# BENCHMARK board: Raspberry Pi Pico (RP2040)");
  report("# BENCHMARK columns: name,used,total,percent (or name,value)");
  reportValue("runs", BENCHMARK_RUNS, 0);
  reportValue("latency_mean_ms", mean, 4);
  reportValue("latency_std_ms", deviation, 4);
  reportValue("cpu_cycles_per_inference_mean", cycleSum / BENCHMARK_RUNS, 0);
  reportValue("throughput_inferences_per_s", 1000.0 / mean, 1);
  // CPU load if the model runs once per grid step, as on the ESP32-S3
  reportValue("cpu_load_percent_one_inference_per_step",
              100.0 * mean / (MODEL_GRID_MINUTES * 60.0 * 1000.0), 6);
  reportValue("cpu_frequency_mhz", rp2040.f_cpu() / 1000000.0, 0);

  reportPercent("tensor_arena_bytes", interpreter->arena_used_bytes(), TENSOR_ARENA_BYTES);
  reportPercent("model_bytes_of_flash", g_model_data_len, PICO_FLASH_BYTES);
  unsigned long programBytes = (uint32_t)&__flash_binary_end - FLASH_START_ADDRESS;
  reportPercent("sketch_bytes_of_flash", programBytes, PICO_FLASH_BYTES);
  // The RP2040 core reports the heap now, not its peak: the benchmark does
  // not allocate memory, so the value after the runs is representative.
  reportPercent("heap_used_bytes", rp2040.getUsedHeap(), rp2040.getTotalHeap());
  reportPercent("heap_of_sram_bytes", rp2040.getTotalHeap(), PICO_SRAM_BYTES);

  if (powerMeterReady) {
    float idleMa, idleMw, activeMa, activeMw, volts;
    measurePower(false, idleMa, idleMw, volts);
    measurePower(true, activeMa, activeMw, volts);
    reportValue("supply_voltage_v", volts, 3);
    reportValue("current_idle_ma", idleMa, 2);
    reportValue("power_idle_mw", idleMw, 2);
    reportValue("current_inference_ma", activeMa, 2);
    reportValue("power_inference_mw", activeMw, 2);
    reportValue("energy_per_inference_mj", activeMw * mean / 1000.0, 6);
  } else {
    report("# BENCHMARK power not measured: INA219 not found on the I2C bus");
  }
  report("# BENCHMARK done");

  if (storageReady) {
    File file = LittleFS.open(BENCHMARK_FILE_PATH, "w");  // overwrites
    if (file) {
      file.print(benchmarkReport);
      file.close();
    }
  }
}

void printLastBenchmark() {
  Serial.println("# LASTBENCH BEGIN");
  File file = storageReady ? LittleFS.open(BENCHMARK_FILE_PATH, "r") : File();
  if (file) {
    while (file.available()) {
      Serial.write(file.read());
    }
    file.close();
  }
  Serial.println("# LASTBENCH END");
}

// ------------------------------------------------------------- commands ----

void printStatus() {
  Serial.println("# STATUS board=Raspberry Pi Pico (RP2040)");
  Serial.print("# STATUS model=");
  Serial.println(modelReady ? "ok" : "not_ready");
  Serial.print("# STATUS sensor=");
  Serial.println(sensorReady ? "ok" : "not_ready");
  Serial.print("# STATUS power_meter=");
  Serial.println(powerMeterReady ? "ok" : "not_found");
  Serial.print("# STATUS storage=");
  Serial.println(storageReady ? "ok" : "not_available");
  Serial.print("# STATUS model_inputs=");
  Serial.print(MODEL_NUM_INPUTS);
  Serial.print(" classes=");
  Serial.println(MODEL_NUM_CLASSES);
  if (modelReady) {
    Serial.print("# STATUS tensor_arena_used_bytes=");
    Serial.println(interpreter->arena_used_bytes());
  }
}

void runCommand(String line) {
  line.trim();
  if (line.length() == 0) {
    return;
  }
  String upper = line;
  upper.toUpperCase();
  if (upper == "STATUS") {
    printStatus();
  } else if (upper == "TEST") {
    testSensor();
  } else if (upper == "SAMPLE") {
    printSample();
  } else if (upper == "BENCHMARK") {
    runBenchmark();
  } else if (upper == "LASTBENCH") {
    printLastBenchmark();
  } else if (upper.startsWith("VECTOR ")) {
    runVector(line.substring(7));
  } else if (upper == "HELP") {
    Serial.println("# Commands: STATUS, TEST, SAMPLE, BENCHMARK, LASTBENCH, "
                   "VECTOR <int8 values>, HELP");
  } else {
    Serial.print("# ERROR: unknown command: ");
    Serial.println(line.substring(0, 40));
  }
}

void readSerialCommands() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      runCommand(commandLine);
      commandLine = "";
    } else if (commandLine.length() < 512) {
      commandLine += c;
    }
  }
}

// ----------------------------------------------------------------- main ----

void setup() {
  Serial.begin(SERIAL_BAUD_RATE);
  delay(2000);  // the USB serial port of the Pico needs a moment to appear
  Serial.println("# Raspberry Pi Pico (RP2040) - benchmark firmware");

  Wire.setSDA(I2C_SDA_PIN);
  Wire.setSCL(I2C_SCL_PIN);
  Wire.begin();
  startSensor();
  powerMeterReady = ina219.begin(&Wire);
  startModel();
  // Needs a filesystem area in the flash: see firmware/README.md (Flash Size
  // option). If there is none, the report is only printed.
  storageReady = LittleFS.begin();
  printStatus();

#if RUN_BENCHMARK_AT_BOOT
  delay(BENCHMARK_AT_BOOT_DELAY_MS);
  runBenchmark();
#endif
}

void loop() {
  readSerialCommands();
  delay(10);
}

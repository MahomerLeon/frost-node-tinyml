// Inference firmware for the frost-risk node (ESP32-S3 DevKitC-1).
//
// The model runs ON the ESP32-S3 with TensorFlow Lite Micro (R2).
// This sketch works on its own in the field: it also does the job of the
// logger, so only one firmware is needed once a model exists.
//
// What it does:
// 1. Reads the BME280 every SAMPLE_INTERVAL_MINUTES and saves every reading
//    in /log.csv (same format as firmware/logger).
// 2. Averages the readings of each grid step (30 min), like
//    ml/prepare_dataset.py, and keeps the last MODEL_WINDOW_STEPS steps (3 h)
//    in a circular buffer (R6).
// 3. When a step closes and the window is complete, builds the model input
//    with the same transformations as the training code (dew point, hour as
//    sine/cosine, standardization, int8 quantization) and runs the model.
// 4. Prints the prediction and saves it in /predictions.csv.
//
// Serial commands (one per line, 115200 baud):
//   SETTIME <epoch>   set the clock (seconds since 1970-01-01 UTC). Needed:
//                     the model uses the hour of the day.
//   STATUS            clock, sensor, model, buffer and storage state
//   PREDICT           run the model now with the current window
//   DUMP              print /log.csv (used by ml/serial_dump.py)
//   DUMPPRED          print /predictions.csv (used by scraper/node_listener.py)
//   CLEAR             delete both files
//   BENCHMARK         time BENCHMARK_RUNS inferences and report resources (R7),
//                     including power if an INA219 is connected
//   LASTBENCH         print the last benchmark report saved in the flash
//   VECTOR a,b,c,...  run the model on one already-quantized int8 input and
//                     print the raw int8 output
//   WINDOW <hour> t,h,p;t,h,p;...   run the full preprocessing + model on one
//                     window of raw readings (oldest first) and print the raw
//                     int8 output. Nothing is stored.
//   HELP              list the commands
// VECTOR and WINDOW are used by ml/validate_on_device.py to compare the node
// with the PC.
//
// Lines starting with "#" are messages for humans.

#include <Wire.h>
#include <LittleFS.h>
#include <sys/time.h>
#include <Adafruit_BME280.h>
#include <Adafruit_INA219.h>

#include <Chirale_TensorFlowLite.h>
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"

#include "config.h"
#include "model_data.h"       // generated by ml/convert_tflite.py
#include "circular_buffer.h"

#if USE_REFERENCE_PROBE
#include <OneWire.h>
#include <DallasTemperature.h>
OneWire oneWire(ONE_WIRE_PIN);
DallasTemperature probe(&oneWire);
#endif

#if USE_WIFI_NTP
#include <WiFi.h>
#if __has_include("secrets.h")
#include "secrets.h"
#else
#error "USE_WIFI_NTP is 1 but secrets.h is missing: copy secrets.example.h to secrets.h and write your Wi-Fi name and password, or set USE_WIFI_NTP to 0 in config.h"
#endif
#endif

const uint8_t CHIP_ID_REGISTER = 0xD0;
const uint8_t CHIP_ID_BME280 = 0x60;
const time_t EARLIEST_VALID_EPOCH = 1577836800;  // 2020-01-01 UTC
const unsigned long SAMPLE_INTERVAL_MS = SAMPLE_INTERVAL_MINUTES * 60UL * 1000UL;
const long GRID_SECONDS = MODEL_GRID_MINUTES * 60L;

// ---- sensor and buffer ----
Adafruit_BME280 bme;
bool sensorReady = false;
CircularBuffer<MODEL_WINDOW_STEPS> window;

// Readings of the grid step that is still open (they are averaged at the end)
long openStepStart = -1;  // local time of the start of the step, in seconds
float sumTemperature = 0, sumHumidity = 0, sumPressure = 0;
int readingsInStep = 0;

// ---- power meter (optional) ----
Adafruit_INA219 ina219(INA219_I2C_ADDRESS);
bool powerMeterReady = false;

// ---- storage ----
bool storageReady = false;

// ---- TensorFlow Lite Micro ----
alignas(16) uint8_t tensorArena[TENSOR_ARENA_BYTES];
tflite::MicroInterpreter *interpreter = nullptr;
TfLiteTensor *inputTensor = nullptr;
TfLiteTensor *outputTensor = nullptr;
bool modelReady = false;

unsigned long lastSampleMs = 0;
String commandLine = "";

// ---------------------------------------------------------------- clock ----

bool isClockSet() {
  return time(nullptr) >= EARLIEST_VALID_EPOCH;
}

long localSeconds() {
  return (long)time(nullptr) + UTC_OFFSET_SECONDS;
}

String formatLocalTime(long localEpoch) {
  time_t t = localEpoch;
  struct tm parts;
  gmtime_r(&t, &parts);
  char text[20];
  strftime(text, sizeof(text), "%Y-%m-%dT%H:%M:%S", &parts);
  return String(text) + UTC_OFFSET_TEXT;
}

#if USE_WIFI_NTP
// Connects to Wi-Fi, asks an NTP server for the time and turns Wi-Fi off.
void syncClockWithNtp() {
  Serial.println("# Connecting to Wi-Fi for NTP...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_TIMEOUT_MS) {
    delay(250);
  }
  if (WiFi.status() == WL_CONNECTED) {
    configTime(0, 0, NTP_SERVER, NTP_SERVER_2, NTP_SERVER_3);  // clock in UTC
    start = millis();
    while (!isClockSet() && millis() - start < NTP_TIMEOUT_MS) {
      delay(250);
    }
  }
  Serial.println(isClockSet() ? "# Clock set by NTP"
                              : "# WARNING: NTP failed. Use SETTIME <epoch>.");
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
}
#endif

// --------------------------------------------------------------- sensor ----

uint8_t readChipId() {
  Wire.beginTransmission(BME280_I2C_ADDRESS);
  Wire.write(CHIP_ID_REGISTER);
  if (Wire.endTransmission() != 0) {
    return 0;
  }
  Wire.requestFrom(BME280_I2C_ADDRESS, (uint8_t)1);
  return Wire.available() < 1 ? 0 : Wire.read();
}

void startSensor() {
  sensorReady = false;
  if (readChipId() != CHIP_ID_BME280) {
    return;
  }
  if (!bme.begin(BME280_I2C_ADDRESS, &Wire)) {
    return;
  }
  // Forced mode avoids self-heating (same setting as the logger)
  bme.setSampling(Adafruit_BME280::MODE_FORCED,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::SAMPLING_X1,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::FILTER_OFF);
  sensorReady = true;
}

// -------------------------------------------------------------- storage ----

unsigned long countRows(const char *path);

// Creates a CSV file with its header if it does not exist. If the file has
// the header of an older firmware: with no data rows it is started again;
// with data rows it is kept and a warning asks to DUMP it and then CLEAR.
void createFileIfMissing(const char *path, const char *header) {
  if (LittleFS.exists(path)) {
    File file = LittleFS.open(path, FILE_READ);
    String firstLine = file ? file.readStringUntil('\n') : String("");
    if (file) {
      file.close();
    }
    firstLine.trim();
    if (firstLine == header) {
      return;
    }
    if (countRows(path) > 0) {
      Serial.print("# WARNING: ");
      Serial.print(path);
      Serial.println(" has the columns of an older firmware. DUMP it, then CLEAR.");
      return;
    }
    LittleFS.remove(path);
  }
  File file = LittleFS.open(path, FILE_WRITE);
  if (file) {
    file.println(header);
    file.close();
  }
}

// Reads the reference probe (DS18B20). NAN if disabled or not answering.
// Same rules as firmware/logger: -127 means no probe, 85.0 is the power-on
// value of the chip and is not trusted.
float readReferenceC() {
#if USE_REFERENCE_PROBE
  probe.requestTemperatures();
  float value = probe.getTempCByIndex(0);
  if (value == DEVICE_DISCONNECTED_C || value == 85.0f || value < -55.0f || value > 125.0f) {
    return NAN;
  }
  return value;
#else
  return NAN;
#endif
}

// Appends one line to a file. Does nothing if the storage is not available.
void appendLine(const char *path, const String &line) {
  if (!storageReady) {
    return;
  }
  File file = LittleFS.open(path, FILE_APPEND);
  if (!file || file.println(line) == 0) {
    Serial.println("# WARNING: could not write to the flash (full?)");
  }
  if (file) {
    file.close();
  }
}

unsigned long countRows(const char *path) {
  File file = LittleFS.open(path, FILE_READ);
  if (!file) {
    return 0;
  }
  unsigned long lines = 0;
  while (file.available()) {
    if (file.read() == '\n') {
      lines++;
    }
  }
  file.close();
  return lines > 0 ? lines - 1 : 0;  // the header is not a data row
}

void dumpFile(const char *path, const char *name) {
  Serial.print("# ");
  Serial.print(name);
  Serial.println(" BEGIN");
  File file = LittleFS.open(path, FILE_READ);
  if (file) {
    while (file.available()) {
      Serial.write(file.read());
    }
    file.close();
  }
  Serial.print("# ");
  Serial.print(name);
  Serial.println(" END");
}

// ---------------------------------------------------------------- model ----

// Dew point with the Magnus formula. Same formula and constants as
// dew_point_c() in ml/prepare_dataset.py (a = 17.625, b = 243.04 C).
float dewPointC(float temperatureC, float humidityPct) {
  const float a = 17.625f;
  const float b = 243.04f;
  float gamma = logf(humidityPct / 100.0f) + a * temperatureC / (b + temperatureC);
  return b * gamma / (a - gamma);
}

void startModel() {
  const tflite::Model *model = tflite::GetModel(g_model_data);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.println("# ERROR: model schema version not supported by the library");
    return;
  }
  // Only the operations this model uses are linked, to save Flash:
  // a dense layer is FULLY_CONNECTED (its ReLU is fused) and the output
  // layer adds SOFTMAX.
  static tflite::MicroMutableOpResolver<2> resolver;
  resolver.AddFullyConnected();
  resolver.AddSoftmax();

  static tflite::MicroInterpreter staticInterpreter(
      model, resolver, tensorArena, TENSOR_ARENA_BYTES);
  interpreter = &staticInterpreter;
  if (interpreter->AllocateTensors() != kTfLiteOk) {
    Serial.println("# ERROR: AllocateTensors failed (tensor arena too small?)");
    return;
  }
  inputTensor = interpreter->input(0);
  outputTensor = interpreter->output(0);
  if (inputTensor->type != kTfLiteInt8 || outputTensor->type != kTfLiteInt8 ||
      inputTensor->bytes != MODEL_NUM_INPUTS || outputTensor->bytes != MODEL_NUM_CLASSES) {
    Serial.println("# ERROR: the model does not match model_data.h constants");
    return;
  }
  modelReady = true;
}

// Fills the int8 input tensor from MODEL_WINDOW_STEPS readings (oldest
// first) and the hour of the day (0.0 .. 23.99) of the newest step.
//
// Input order (must match feature_columns() in ml/dataset_utils.py):
//   temperature oldest..newest, humidity oldest..newest,
//   [pressure oldest..newest], dew point oldest..newest, hour_sin, hour_cos
void fillInput(const Reading *readings, float hour) {
  float features[MODEL_NUM_INPUTS];
  int n = 0;
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = readings[i].temperatureC;
  }
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = readings[i].humidityPct;
  }
#if MODEL_USES_PRESSURE
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = readings[i].pressureHpa;
  }
#endif
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = dewPointC(readings[i].temperatureC, readings[i].humidityPct);
  }
  features[n++] = sinf(2.0f * PI * hour / 24.0f);
  features[n++] = cosf(2.0f * PI * hour / 24.0f);

  float scale = inputTensor->params.scale;
  int zeroPoint = inputTensor->params.zero_point;
  for (int i = 0; i < MODEL_NUM_INPUTS; i++) {
    float standardized = (features[i] - MODEL_INPUT_MEAN[i]) / MODEL_INPUT_STD[i];
    long quantized = lroundf(standardized / scale) + zeroPoint;
    inputTensor->data.int8[i] = (int8_t)constrain(quantized, -128L, 127L);
  }
}

bool windowIsComplete() {
  if (!window.isFull()) {
    return false;
  }
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    if (!window.get(i).valid) {
      return false;
    }
  }
  return true;
}

int bestClass() {
  int best = 0;
  for (int c = 1; c < MODEL_NUM_CLASSES; c++) {
    if (outputTensor->data.int8[c] > outputTensor->data.int8[best]) {
      best = c;
    }
  }
  return best;
}

void printRawOutput() {
  Serial.print("RESULT");
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    Serial.print(c == 0 ? " " : ",");
    Serial.print(outputTensor->data.int8[c]);
  }
  Serial.println();
}

// Runs the model on the current window, prints the result and, if `save` is
// true, appends it to /predictions.csv. stepStart is the local time (seconds)
// of the START of the newest step: the timestamp ml/prepare_dataset.py gives
// to the window.
void predict(long stepStart, bool save) {
  if (!modelReady) {
    Serial.println("# PREDICT skipped: model not ready");
    return;
  }
  if (!windowIsComplete()) {
    Serial.print("# PREDICT skipped: window not complete (steps stored: ");
    Serial.print(window.size());
    Serial.print(" of ");
    Serial.print(MODEL_WINDOW_STEPS);
    Serial.println(")");
    return;
  }
  Reading readings[MODEL_WINDOW_STEPS];
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    readings[i] = window.get(i);  // 0 = oldest
  }
  fillInput(readings, (stepStart % 86400L) / 3600.0f);
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  // int8 output -> probability:  p = (q - zero_point) * scale
  int best = bestClass();
  String probabilities = "";
  String line = "PREDICTION," + formatLocalTime(stepStart) + ",class=" + String(best);
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    float probability = (outputTensor->data.int8[c] - outputTensor->params.zero_point) *
                        outputTensor->params.scale;
    line += ",p" + String(c) + "=" + String(probability, 3);
    probabilities += (c == 0 ? "" : ";") + String(probability, 3);
  }
  Serial.println(line);

  if (save) {
    const Reading &newest = readings[MODEL_WINDOW_STEPS - 1];
    appendLine(PREDICTIONS_FILE_PATH,
               formatLocalTime(stepStart) + "," + String(newest.temperatureC, 2) + "," +
               String(newest.humidityPct, 2) + "," + String(newest.pressureHpa, 2) + "," +
               String(best) + "," + probabilities);
  }
}

// ------------------------------------------------------------- sampling ----

// Closes the open grid step: stores its average in the circular buffer and
// runs the model.
void closeStep() {
  Reading average = {NAN, NAN, NAN, false};
  if (readingsInStep > 0) {
    average.temperatureC = sumTemperature / readingsInStep;
    average.humidityPct = sumHumidity / readingsInStep;
    average.pressureHpa = sumPressure / readingsInStep;
    average.valid = true;
  }
  window.push(average);  // O(1)
  Serial.print("STEP,");
  Serial.print(formatLocalTime(openStepStart));
  Serial.print(",");
  Serial.print(average.temperatureC, 2);
  Serial.print(",");
  Serial.print(average.humidityPct, 2);
  Serial.print(",");
  Serial.print(average.pressureHpa, 2);
  Serial.println(average.valid ? ",ok" : ",no_data");
  predict(openStepStart, true);
}

void takeSample() {
#if USE_WIFI_NTP
  // Same as the logger: retry NTP while the clock is not set.
  if (!isClockSet()) {
    syncClockWithNtp();
  }
#endif
  if (!isClockSet()) {
    Serial.println("# WARNING: clock not set. Send SETTIME <epoch>.");
    return;
  }
  long now = localSeconds();
  long stepStart = (now / GRID_SECONDS) * GRID_SECONDS;

  if (openStepStart >= 0 && stepStart != openStepStart) {
    closeStep();
    // If whole steps were skipped (node off, clock changed), the readings in
    // the buffer are no longer consecutive: start the window again.
    if (stepStart - openStepStart != GRID_SECONDS) {
      window.clear();
      Serial.println("# WARNING: time gap detected, window restarted");
    }
    sumTemperature = sumHumidity = sumPressure = 0;
    readingsInStep = 0;
  }
  openStepStart = stepStart;

  float temperatureC = NAN, humidityPct = NAN, pressureHpa = NAN;
  if (!sensorReady) {
    startSensor();
  }
  if (sensorReady && bme.takeForcedMeasurement()) {
    temperatureC = bme.readTemperature();
    humidityPct = bme.readHumidity();
    pressureHpa = bme.readPressure() / 100.0f;
  }
  // Same validity limits as the logger (BME280 datasheet ranges). Humidity
  // must be above 0 because the dew point uses its logarithm.
  bool valid = temperatureC >= -40 && temperatureC <= 85 &&
               humidityPct > 0 && humidityPct <= 100 &&
               pressureHpa >= 300 && pressureHpa <= 1100;

  // Every reading is saved, like in the logger, so this firmware also
  // produces the own dataset.
  String row = formatLocalTime(now) + "," + String(temperatureC, 2) + "," +
               String(humidityPct, 2) + "," + String(pressureHpa, 2) + "," +
               String(readReferenceC(), 2) + "," +
               (valid ? "ok" : "sensor_error");
  Serial.println(row);
  appendLine(LOG_FILE_PATH, row);

  if (!valid) {
    sensorReady = false;  // start the sensor again before the next reading
    return;
  }
  sumTemperature += temperatureC;
  sumHumidity += humidityPct;
  sumPressure += pressureHpa;
  readingsInStep++;
}

// ------------------------------------------------------------- commands ----

// The benchmark report is printed AND kept in this text, so it can be saved
// to the flash and read later with LASTBENCH.
String benchmarkReport = "";

void report(const String &line) {
  Serial.println(line);
  benchmarkReport += line + "\n";
}

void reportValue(const char *name, double value, int decimals) {
  report(String("BENCHMARK,") + name + "," + String(value, decimals));
}

void reportPercent(const char *name, unsigned long used, unsigned long total) {
  report(String("BENCHMARK,") + name + "," + String(used) + "," + String(total) +
         "," + String(100.0f * used / total, 2));
}

// Average power at the 5 V input while the CPU is idle or running inferences
// without pause. The INA219 is in series with the supply, so the values
// include the losses of the voltage regulator of the board.
void measurePower(bool runInferences, float &currentMa, float &powerMw, float &busVoltageV) {
  currentMa = powerMw = busVoltageV = 0;
  for (int i = 0; i < POWER_SAMPLES; i++) {
    unsigned long start = millis();
    while (millis() - start < POWER_SAMPLE_PERIOD_MS) {
      if (runInferences) {
        interpreter->Invoke();
      } else {
        delay(1);
      }
    }
    currentMa += ina219.getCurrent_mA();
    powerMw += ina219.getPower_mW();
    busVoltageV += ina219.getBusVoltage_V();
  }
  currentMa /= POWER_SAMPLES;
  powerMw /= POWER_SAMPLES;
  busVoltageV /= POWER_SAMPLES;
}

// Times BENCHMARK_RUNS inferences and reports the resources used (R7).
void runBenchmark() {
  if (!modelReady) {
    Serial.println("# BENCHMARK skipped: model not ready");
    return;
  }
  benchmarkReport = "";
  // The time of a dense int8 model does not depend on the input values, so
  // the benchmark uses whatever is in the input tensor.
  double sum = 0, sumSquares = 0, cycleSum = 0;
  for (int i = 0; i < BENCHMARK_RUNS; i++) {
    // CPU cycles from the cycle counter of the Xtensa core (CCOUNT register)
    uint32_t startCycles = ESP.getCycleCount();
    unsigned long start = micros();
    interpreter->Invoke();
    double ms = (micros() - start) / 1000.0;
    cycleSum += (uint32_t)(ESP.getCycleCount() - startCycles);
    sum += ms;
    sumSquares += ms * ms;
  }
  double mean = sum / BENCHMARK_RUNS;
  double variance = (sumSquares - BENCHMARK_RUNS * mean * mean) / (BENCHMARK_RUNS - 1);
  double deviation = variance > 0 ? sqrt(variance) : 0;

  report("# BENCHMARK columns: name,used,total,percent (or name,value)");
  report("# BENCHMARK time: " +
         (isClockSet() ? formatLocalTime(localSeconds()) : String("TIME_NOT_SET")));
  reportValue("runs", BENCHMARK_RUNS, 0);
  reportValue("latency_mean_ms", mean, 4);
  reportValue("latency_std_ms", deviation, 4);
  reportValue("cpu_cycles_per_inference_mean", cycleSum / BENCHMARK_RUNS, 0);
  reportValue("throughput_inferences_per_s", 1000.0 / mean, 1);
  // CPU load of inference: one inference per grid step
  reportValue("cpu_load_percent_one_inference_per_step",
              100.0 * mean / (GRID_SECONDS * 1000.0), 6);
  reportValue("cpu_frequency_mhz", getCpuFrequencyMhz(), 0);

  reportPercent("tensor_arena_bytes", interpreter->arena_used_bytes(), TENSOR_ARENA_BYTES);
  reportPercent("model_bytes_of_flash", g_model_data_len, ESP.getFlashChipSize());
  // On the ESP32, getFreeSketchSpace() returns the full size of the program
  // partition (the space available for a sketch), not the unused part.
  reportPercent("sketch_bytes_of_app_partition", ESP.getSketchSize(),
                ESP.getFreeSketchSpace());
  reportPercent("sketch_bytes_of_flash", ESP.getSketchSize(), ESP.getFlashChipSize());
  reportPercent("heap_used_peak_bytes", ESP.getHeapSize() - ESP.getMinFreeHeap(),
                ESP.getHeapSize());
  reportValue("heap_min_free_bytes", ESP.getMinFreeHeap(), 0);
  // Stack of the task that runs loop(): the high-water mark is the smallest
  // amount of stack that has ever been free, so used = size - mark.
  unsigned long stackSize = getArduinoLoopTaskStackSize();
  reportPercent("stack_used_peak_bytes",
                stackSize - uxTaskGetStackHighWaterMark(nullptr), stackSize);

  // ---- power (only if the INA219 answers on the I2C bus) ----
  if (powerMeterReady) {
    float idleMa, idleMw, activeMa, activeMw, volts;
    measurePower(false, idleMa, idleMw, volts);
    measurePower(true, activeMa, activeMw, volts);
    reportValue("supply_voltage_v", volts, 3);
    reportValue("current_idle_ma", idleMa, 2);
    reportValue("power_idle_mw", idleMw, 2);
    reportValue("current_inference_ma", activeMa, 2);
    reportValue("power_inference_mw", activeMw, 2);
    // energy = power x time:  mW x ms = microjoules;  / 1000 = millijoules
    reportValue("energy_per_inference_mj", activeMw * mean / 1000.0, 6);
  } else {
    report("# BENCHMARK power not measured: INA219 not found on the I2C bus");
  }
  report("# BENCHMARK done");

  // Keep the last report in the flash: when the node is powered through the
  // INA219 there is no PC connected to read the serial port.
  if (storageReady) {
    File file = LittleFS.open(BENCHMARK_FILE_PATH, FILE_WRITE);  // overwrites
    if (file) {
      file.print(benchmarkReport);
      file.close();
    }
  }
}

// Reads the next number of a text like "1.5,2;3 4": skips separators, then
// converts. Returns false when the text is finished.
bool nextNumber(const char *&position, float &value) {
  while (*position == ' ' || *position == ',' || *position == ';') {
    position++;
  }
  if (*position == '\0') {
    return false;
  }
  char *end;
  value = strtof(position, &end);
  if (end == position) {
    return false;  // not a number
  }
  position = end;
  return true;
}

// VECTOR a,b,c,...  -> RESULT x,y,...   (raw int8 values, no preprocessing)
void runVector(const String &values) {
  if (!modelReady) {
    Serial.println("# VECTOR skipped: model not ready");
    return;
  }
  const char *position = values.c_str();
  for (int i = 0; i < MODEL_NUM_INPUTS; i++) {
    float value;
    if (!nextNumber(position, value)) {
      Serial.println("# ERROR: VECTOR has too few values");
      return;
    }
    inputTensor->data.int8[i] = (int8_t)value;
  }
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  printRawOutput();
}

// WINDOW <hour> t,h,p;t,h,p;...  -> RESULT x,y,...
// Runs the complete preprocessing (dew point, hour, standardization,
// quantization) and the model on raw readings given oldest first.
void runWindow(const String &values) {
  if (!modelReady) {
    Serial.println("# WINDOW skipped: model not ready");
    return;
  }
  const char *position = values.c_str();
  float hour;
  Reading readings[MODEL_WINDOW_STEPS];
  bool complete = nextNumber(position, hour);
  for (int i = 0; complete && i < MODEL_WINDOW_STEPS; i++) {
    complete = nextNumber(position, readings[i].temperatureC) &&
               nextNumber(position, readings[i].humidityPct) &&
               nextNumber(position, readings[i].pressureHpa);
    readings[i].valid = true;
  }
  if (!complete) {
    Serial.println("# ERROR: WINDOW needs <hour> and t,h,p for every step");
    return;
  }
  fillInput(readings, hour);
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  printRawOutput();
}

void printStatus() {
  Serial.print("# STATUS time=");
  Serial.println(isClockSet() ? formatLocalTime(localSeconds()) : String("TIME_NOT_SET"));
  Serial.print("# STATUS sensor=");
  Serial.println(sensorReady ? "ok" : "not_ready");
  Serial.print("# STATUS model=");
  Serial.println(modelReady ? "ok" : "not_ready");
  Serial.print("# STATUS power_meter=");
  Serial.println(powerMeterReady ? "ok" : "not_found");
#if USE_REFERENCE_PROBE
  Serial.print("# STATUS reference_probes=");
  Serial.println(probe.getDeviceCount());
#endif
  Serial.print("# STATUS window_steps=");
  Serial.print(window.size());
  Serial.print("/");
  Serial.println(MODEL_WINDOW_STEPS);
  Serial.print("# STATUS model_inputs=");
  Serial.print(MODEL_NUM_INPUTS);
  Serial.print(" classes=");
  Serial.print(MODEL_NUM_CLASSES);
  Serial.print(" uses_pressure=");
  Serial.println(MODEL_USES_PRESSURE);
  if (modelReady) {
    Serial.print("# STATUS tensor_arena_used_bytes=");
    Serial.println(interpreter->arena_used_bytes());
  }
  if (storageReady) {
    Serial.print("# STATUS log_rows=");
    Serial.println(countRows(LOG_FILE_PATH));
    Serial.print("# STATUS prediction_rows=");
    Serial.println(countRows(PREDICTIONS_FILE_PATH));
    Serial.print("# STATUS flash_free_bytes=");
    Serial.println(LittleFS.totalBytes() - LittleFS.usedBytes());
  } else {
    Serial.println("# STATUS flash storage NOT available");
  }
}

void runCommand(String line) {
  line.trim();
  if (line.length() == 0) {
    return;
  }
  String upper = line;
  upper.toUpperCase();

  if (upper.startsWith("SETTIME ")) {
    long long epoch = atoll(line.substring(8).c_str());
    if (epoch < EARLIEST_VALID_EPOCH) {
      Serial.println("# ERROR: SETTIME needs seconds since 1970");
      return;
    }
    struct timeval now = {(time_t)epoch, 0};
    settimeofday(&now, nullptr);
    Serial.print("# SETTIME done: ");
    Serial.println(formatLocalTime(localSeconds()));
  } else if (upper == "STATUS") {
    printStatus();
  } else if (upper == "PREDICT") {
    predict(openStepStart, false);
  } else if (upper == "DUMP") {
    dumpFile(LOG_FILE_PATH, "DUMP");
  } else if (upper == "DUMPPRED") {
    dumpFile(PREDICTIONS_FILE_PATH, "DUMPPRED");
  } else if (upper == "CLEAR") {
    LittleFS.remove(LOG_FILE_PATH);
    LittleFS.remove(PREDICTIONS_FILE_PATH);
    createFileIfMissing(LOG_FILE_PATH, LOG_FILE_HEADER);
    createFileIfMissing(PREDICTIONS_FILE_PATH, PREDICTIONS_FILE_HEADER);
    Serial.println("# CLEAR done: readings and predictions deleted");
  } else if (upper == "BENCHMARK") {
    runBenchmark();
  } else if (upper == "LASTBENCH") {
    dumpFile(BENCHMARK_FILE_PATH, "LASTBENCH");
  } else if (upper.startsWith("VECTOR ")) {
    runVector(line.substring(7));
  } else if (upper.startsWith("WINDOW ")) {
    runWindow(line.substring(7));
  } else if (upper == "HELP") {
    Serial.println("# Commands: SETTIME <epoch>, STATUS, PREDICT, DUMP, DUMPPRED, CLEAR, "
                   "BENCHMARK, LASTBENCH, VECTOR <int8 values>, WINDOW <hour> <readings>, HELP");
  } else {
    Serial.print("# ERROR: unknown command: ");
    Serial.println(line.substring(0, 40));
  }
}

void readSerialCommands() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      runCommand(commandLine);
      commandLine = "";
    } else if (commandLine.length() < 512) {
      commandLine += c;
    }
  }
}

// ----------------------------------------------------------------- main ----

void setup() {
  Serial.begin(SERIAL_BAUD_RATE);
  delay(1000);
  Serial.println("# Frost node - inference firmware");

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  startSensor();
  startModel();

  // true = format the flash partition the first time it is used
  storageReady = LittleFS.begin(true);
  if (storageReady) {
    createFileIfMissing(LOG_FILE_PATH, LOG_FILE_HEADER);
    createFileIfMissing(PREDICTIONS_FILE_PATH, PREDICTIONS_FILE_HEADER);
  }

#if USE_WIFI_NTP
  syncClockWithNtp();
#endif

  powerMeterReady = ina219.begin(&Wire);  // false if no INA219 is connected
#if USE_REFERENCE_PROBE
  probe.begin();  // finds the DS18B20 on the 1-Wire bus, if there is one
#endif

  printStatus();

#if RUN_BENCHMARK_AT_BOOT
  // Used to measure power: the node is powered through the INA219, without a
  // PC, so nobody can type BENCHMARK. The report is read later with LASTBENCH.
  delay(BENCHMARK_AT_BOOT_DELAY_MS);
  runBenchmark();
#endif

  lastSampleMs = millis() - SAMPLE_INTERVAL_MS;  // first reading right away
}

void loop() {
  readSerialCommands();
  if (millis() - lastSampleMs >= SAMPLE_INTERVAL_MS) {
    lastSampleMs += SAMPLE_INTERVAL_MS;
    takeSample();
  }
  delay(10);
}

// Inference firmware for the frost-risk node (ESP32-S3 DevKitC-1).
//
// The model runs ON the ESP32-S3 with TensorFlow Lite Micro (R2).
//
// What it does:
// 1. Reads the BME280 every SAMPLE_INTERVAL_MINUTES and averages the readings
//    of each grid step (30 min), like ml/prepare_dataset.py.
// 2. Keeps the last MODEL_WINDOW_STEPS steps (3 h) in a circular buffer (R6).
// 3. When a step closes and the window is complete, builds the model input
//    with the same transformations as the training code (dew point, hour as
//    sine/cosine, standardization, int8 quantization) and runs the model.
// 4. Prints the predicted class, the probabilities and the time.
//
// Serial commands (one per line, 115200 baud):
//   SETTIME <epoch>   set the clock (seconds since 1970-01-01 UTC). Needed:
//                     the model uses the hour of the day.
//   STATUS            clock, sensor, buffer and memory state
//   PREDICT           run the model now with the current window
//   BENCHMARK         time BENCHMARK_RUNS inferences and report resources (R7)
//   VECTOR a,b,c,...  run the model on one already-quantized int8 input and
//                     print the raw int8 output (used by
//                     ml/validate_on_device.py to compare with the PC)
//   HELP              list the commands
//
// Lines starting with "#" are messages for humans.

#include <Wire.h>
#include <sys/time.h>
#include <Adafruit_BME280.h>

#include <Chirale_TensorFlowLite.h>
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"

#include "config.h"
#include "model_data.h"       // generated by ml/convert_tflite.py
#include "circular_buffer.h"

const uint8_t CHIP_ID_REGISTER = 0xD0;
const uint8_t CHIP_ID_BME280 = 0x60;
const time_t EARLIEST_VALID_EPOCH = 1577836800;  // 2020-01-01 UTC
const unsigned long SAMPLE_INTERVAL_MS = SAMPLE_INTERVAL_MINUTES * 60UL * 1000UL;
const long GRID_SECONDS = MODEL_GRID_MINUTES * 60L;

// ---- sensor and buffer ----
Adafruit_BME280 bme;
bool sensorReady = false;
CircularBuffer<MODEL_WINDOW_STEPS> window;

// Readings of the grid step that is still open (they are averaged at the end)
long openStepStart = -1;  // local time of the start of the step, in seconds
float sumTemperature = 0, sumHumidity = 0, sumPressure = 0;
int readingsInStep = 0;

// ---- TensorFlow Lite Micro ----
alignas(16) uint8_t tensorArena[TENSOR_ARENA_BYTES];
tflite::MicroInterpreter *interpreter = nullptr;
TfLiteTensor *inputTensor = nullptr;
TfLiteTensor *outputTensor = nullptr;
bool modelReady = false;

unsigned long lastSampleMs = 0;
String commandLine = "";

// ---------------------------------------------------------------- clock ----

bool isClockSet() {
  return time(nullptr) >= EARLIEST_VALID_EPOCH;
}

long localSeconds() {
  return (long)time(nullptr) + UTC_OFFSET_SECONDS;
}

String formatLocalTime(long localEpoch) {
  time_t t = localEpoch;
  struct tm parts;
  gmtime_r(&t, &parts);
  char text[20];
  strftime(text, sizeof(text), "%Y-%m-%dT%H:%M:%S", &parts);
  return String(text) + UTC_OFFSET_TEXT;
}

// --------------------------------------------------------------- sensor ----

uint8_t readChipId() {
  Wire.beginTransmission(BME280_I2C_ADDRESS);
  Wire.write(CHIP_ID_REGISTER);
  if (Wire.endTransmission() != 0) {
    return 0;
  }
  Wire.requestFrom(BME280_I2C_ADDRESS, (uint8_t)1);
  return Wire.available() < 1 ? 0 : Wire.read();
}

void startSensor() {
  sensorReady = false;
  if (readChipId() != CHIP_ID_BME280) {
    return;
  }
  if (!bme.begin(BME280_I2C_ADDRESS, &Wire)) {
    return;
  }
  // Forced mode avoids self-heating (same setting as the logger)
  bme.setSampling(Adafruit_BME280::MODE_FORCED,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::SAMPLING_X1,
                  Adafruit_BME280::SAMPLING_X1, Adafruit_BME280::FILTER_OFF);
  sensorReady = true;
}

// ---------------------------------------------------------------- model ----

// Dew point with the Magnus formula. Same formula and constants as
// dew_point_c() in ml/prepare_dataset.py (a = 17.625, b = 243.04 C).
float dewPointC(float temperatureC, float humidityPct) {
  const float a = 17.625f;
  const float b = 243.04f;
  float gamma = logf(humidityPct / 100.0f) + a * temperatureC / (b + temperatureC);
  return b * gamma / (a - gamma);
}

void startModel() {
  const tflite::Model *model = tflite::GetModel(g_model_data);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.println("# ERROR: model schema version not supported by the library");
    return;
  }
  // Only the operations this model uses are linked, to save Flash:
  // a dense layer is FULLY_CONNECTED (its ReLU is fused) and the output
  // layer adds SOFTMAX.
  static tflite::MicroMutableOpResolver<2> resolver;
  resolver.AddFullyConnected();
  resolver.AddSoftmax();

  static tflite::MicroInterpreter staticInterpreter(
      model, resolver, tensorArena, TENSOR_ARENA_BYTES);
  interpreter = &staticInterpreter;
  if (interpreter->AllocateTensors() != kTfLiteOk) {
    Serial.println("# ERROR: AllocateTensors failed (tensor arena too small?)");
    return;
  }
  inputTensor = interpreter->input(0);
  outputTensor = interpreter->output(0);
  if (inputTensor->type != kTfLiteInt8 || outputTensor->type != kTfLiteInt8 ||
      inputTensor->bytes != MODEL_NUM_INPUTS || outputTensor->bytes != MODEL_NUM_CLASSES) {
    Serial.println("# ERROR: the model does not match model_data.h constants");
    return;
  }
  modelReady = true;
}

// Fills the int8 input tensor from the window. stepStart is the local time
// (seconds) of the START of the newest step, which is the timestamp that
// ml/prepare_dataset.py gives to the window.
//
// Input order (must match feature_columns() in ml/dataset_utils.py):
//   temperature oldest..newest, humidity oldest..newest,
//   [pressure oldest..newest], dew point oldest..newest, hour_sin, hour_cos
void fillInputFromWindow(long stepStart) {
  float features[MODEL_NUM_INPUTS];
  int n = 0;
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = window.get(i).temperatureC;
  }
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = window.get(i).humidityPct;
  }
#if MODEL_USES_PRESSURE
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = window.get(i).pressureHpa;
  }
#endif
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    features[n++] = dewPointC(window.get(i).temperatureC, window.get(i).humidityPct);
  }
  float hour = (stepStart % 86400L) / 3600.0f;  // 0.0 .. 23.99
  features[n++] = sinf(2.0f * PI * hour / 24.0f);
  features[n++] = cosf(2.0f * PI * hour / 24.0f);

  float scale = inputTensor->params.scale;
  int zeroPoint = inputTensor->params.zero_point;
  for (int i = 0; i < MODEL_NUM_INPUTS; i++) {
    float standardized = (features[i] - MODEL_INPUT_MEAN[i]) / MODEL_INPUT_STD[i];
    long quantized = lroundf(standardized / scale) + zeroPoint;
    inputTensor->data.int8[i] = (int8_t)constrain(quantized, -128L, 127L);
  }
}

bool windowIsComplete() {
  if (!window.isFull()) {
    return false;
  }
  for (int i = 0; i < MODEL_WINDOW_STEPS; i++) {
    if (!window.get(i).valid) {
      return false;
    }
  }
  return true;
}

// Runs the model on the current window and prints the result.
void predict(long stepStart) {
  if (!modelReady) {
    Serial.println("# PREDICT skipped: model not ready");
    return;
  }
  if (!windowIsComplete()) {
    Serial.print("# PREDICT skipped: window not complete (steps stored: ");
    Serial.print(window.size());
    Serial.print(" of ");
    Serial.print(MODEL_WINDOW_STEPS);
    Serial.println(")");
    return;
  }
  fillInputFromWindow(stepStart);
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  // int8 output -> probability:  p = (q - zero_point) * scale
  int best = 0;
  Serial.print("PREDICTION,");
  Serial.print(formatLocalTime(stepStart));
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    if (outputTensor->data.int8[c] > outputTensor->data.int8[best]) {
      best = c;
    }
  }
  Serial.print(",class=");
  Serial.print(best);
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    float probability = (outputTensor->data.int8[c] - outputTensor->params.zero_point) *
                        outputTensor->params.scale;
    Serial.print(",p");
    Serial.print(c);
    Serial.print("=");
    Serial.print(probability, 3);
  }
  Serial.println();
}

// ------------------------------------------------------------- sampling ----

// Closes the open grid step: stores its average in the circular buffer and
// runs the model.
void closeStep() {
  Reading average = {NAN, NAN, NAN, false};
  if (readingsInStep > 0) {
    average.temperatureC = sumTemperature / readingsInStep;
    average.humidityPct = sumHumidity / readingsInStep;
    average.pressureHpa = sumPressure / readingsInStep;
    average.valid = true;
  }
  window.push(average);  // O(1)
  Serial.print("STEP,");
  Serial.print(formatLocalTime(openStepStart));
  Serial.print(",");
  Serial.print(average.temperatureC, 2);
  Serial.print(",");
  Serial.print(average.humidityPct, 2);
  Serial.print(",");
  Serial.print(average.pressureHpa, 2);
  Serial.println(average.valid ? ",ok" : ",no_data");
  predict(openStepStart);
}

void takeSample() {
  if (!isClockSet()) {
    Serial.println("# WARNING: clock not set. Send SETTIME <epoch>.");
    return;
  }
  long now = localSeconds();
  long stepStart = (now / GRID_SECONDS) * GRID_SECONDS;

  if (openStepStart >= 0 && stepStart != openStepStart) {
    closeStep();
    // If whole steps were skipped (node off, clock changed), the readings in
    // the buffer are no longer consecutive: start the window again.
    if (stepStart - openStepStart != GRID_SECONDS) {
      window.clear();
      Serial.println("# WARNING: time gap detected, window restarted");
    }
    sumTemperature = sumHumidity = sumPressure = 0;
    readingsInStep = 0;
  }
  openStepStart = stepStart;

  if (!sensorReady) {
    startSensor();
  }
  if (!sensorReady || !bme.takeForcedMeasurement()) {
    sensorReady = false;
    Serial.println("# WARNING: sensor error, reading skipped");
    return;
  }
  float temperatureC = bme.readTemperature();
  float humidityPct = bme.readHumidity();
  float pressureHpa = bme.readPressure() / 100.0f;
  // Same validity limits as the logger (BME280 datasheet ranges)
  bool valid = temperatureC >= -40 && temperatureC <= 85 &&
               humidityPct > 0 && humidityPct <= 100 &&
               pressureHpa >= 300 && pressureHpa <= 1100;
  if (!valid) {
    sensorReady = false;
    Serial.println("# WARNING: invalid reading, skipped");
    return;
  }
  sumTemperature += temperatureC;
  sumHumidity += humidityPct;
  sumPressure += pressureHpa;
  readingsInStep++;
}

// ------------------------------------------------------------- commands ----

void printPercent(const char *label, unsigned long used, unsigned long total) {
  Serial.print("BENCHMARK,");
  Serial.print(label);
  Serial.print(",");
  Serial.print(used);
  Serial.print(",");
  Serial.print(total);
  Serial.print(",");
  Serial.println(100.0f * used / total, 2);
}

// Times BENCHMARK_RUNS inferences and reports the resources used (R7).
void runBenchmark() {
  if (!modelReady) {
    Serial.println("# BENCHMARK skipped: model not ready");
    return;
  }
  // The time of a dense int8 model does not depend on the input values, so
  // the benchmark uses whatever is in the input tensor.
  double sum = 0, sumSquares = 0;
  for (int i = 0; i < BENCHMARK_RUNS; i++) {
    unsigned long start = micros();
    interpreter->Invoke();
    double ms = (micros() - start) / 1000.0;
    sum += ms;
    sumSquares += ms * ms;
  }
  double mean = sum / BENCHMARK_RUNS;
  double variance = (sumSquares - BENCHMARK_RUNS * mean * mean) / (BENCHMARK_RUNS - 1);
  double deviation = variance > 0 ? sqrt(variance) : 0;

  Serial.println("# BENCHMARK columns: name,used,total,percent (or name,value)");
  Serial.print("BENCHMARK,runs,");
  Serial.println(BENCHMARK_RUNS);
  Serial.print("BENCHMARK,latency_mean_ms,");
  Serial.println(mean, 4);
  Serial.print("BENCHMARK,latency_std_ms,");
  Serial.println(deviation, 4);
  // CPU load of inference: one inference per grid step
  Serial.print("BENCHMARK,cpu_load_percent_one_inference_per_step,");
  Serial.println(100.0 * mean / (GRID_SECONDS * 1000.0), 6);
  Serial.print("BENCHMARK,cpu_frequency_mhz,");
  Serial.println(getCpuFrequencyMhz());

  printPercent("tensor_arena_bytes", interpreter->arena_used_bytes(), TENSOR_ARENA_BYTES);
  printPercent("model_bytes_of_flash", g_model_data_len, ESP.getFlashChipSize());
  // On the ESP32, getFreeSketchSpace() returns the full size of the program
  // partition (the space available for a sketch), not the unused part.
  printPercent("sketch_bytes_of_app_partition", ESP.getSketchSize(),
               ESP.getFreeSketchSpace());
  printPercent("sketch_bytes_of_flash", ESP.getSketchSize(), ESP.getFlashChipSize());
  printPercent("heap_used_peak_bytes", ESP.getHeapSize() - ESP.getMinFreeHeap(),
               ESP.getHeapSize());
  Serial.print("BENCHMARK,heap_min_free_bytes,");
  Serial.println(ESP.getMinFreeHeap());
  Serial.println("# BENCHMARK done");
}

// VECTOR a,b,c,...  -> RESULT x,y,...   (raw int8 values, no preprocessing)
void runVector(const String &values) {
  if (!modelReady) {
    Serial.println("# VECTOR skipped: model not ready");
    return;
  }
  int position = 0;
  for (int i = 0; i < MODEL_NUM_INPUTS; i++) {
    if (position >= (int)values.length()) {
      Serial.println("# ERROR: VECTOR has too few values");
      return;
    }
    int comma = values.indexOf(',', position);
    if (comma < 0) {
      comma = values.length();
    }
    inputTensor->data.int8[i] = (int8_t)values.substring(position, comma).toInt();
    position = comma + 1;
  }
  if (interpreter->Invoke() != kTfLiteOk) {
    Serial.println("# ERROR: Invoke failed");
    return;
  }
  Serial.print("RESULT");
  for (int c = 0; c < MODEL_NUM_CLASSES; c++) {
    Serial.print(c == 0 ? " " : ",");
    Serial.print(outputTensor->data.int8[c]);
  }
  Serial.println();
}

void printStatus() {
  Serial.print("# STATUS time=");
  Serial.println(isClockSet() ? formatLocalTime(localSeconds()) : String("TIME_NOT_SET"));
  Serial.print("# STATUS sensor=");
  Serial.println(sensorReady ? "ok" : "not_ready");
  Serial.print("# STATUS model=");
  Serial.println(modelReady ? "ok" : "not_ready");
  Serial.print("# STATUS window_steps=");
  Serial.print(window.size());
  Serial.print("/");
  Serial.println(MODEL_WINDOW_STEPS);
  Serial.print("# STATUS model_inputs=");
  Serial.print(MODEL_NUM_INPUTS);
  Serial.print(" classes=");
  Serial.print(MODEL_NUM_CLASSES);
  Serial.print(" uses_pressure=");
  Serial.println(MODEL_USES_PRESSURE);
  if (modelReady) {
    Serial.print("# STATUS tensor_arena_used_bytes=");
    Serial.println(interpreter->arena_used_bytes());
  }
}

void runCommand(String line) {
  line.trim();
  if (line.length() == 0) {
    return;
  }
  String upper = line;
  upper.toUpperCase();

  if (upper.startsWith("SETTIME ")) {
    long long epoch = atoll(line.substring(8).c_str());
    if (epoch < EARLIEST_VALID_EPOCH) {
      Serial.println("# ERROR: SETTIME needs seconds since 1970");
      return;
    }
    struct timeval now = {(time_t)epoch, 0};
    settimeofday(&now, nullptr);
    Serial.print("# SETTIME done: ");
    Serial.println(formatLocalTime(localSeconds()));
  } else if (upper == "STATUS") {
    printStatus();
  } else if (upper == "PREDICT") {
    predict(openStepStart);
  } else if (upper == "BENCHMARK") {
    runBenchmark();
  } else if (upper.startsWith("VECTOR ")) {
    runVector(line.substring(7));
  } else if (upper == "HELP") {
    Serial.println("# Commands: SETTIME <epoch>, STATUS, PREDICT, BENCHMARK, VECTOR <int8 values>, HELP");
  } else {
    Serial.print("# ERROR: unknown command: ");
    Serial.println(line.substring(0, 40));
  }
}

void readSerialCommands() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      runCommand(commandLine);
      commandLine = "";
    } else if (commandLine.length() < 512) {
      commandLine += c;
    }
  }
}

// ----------------------------------------------------------------- main ----

void setup() {
  Serial.begin(SERIAL_BAUD_RATE);
  delay(1000);
  Serial.println("# Frost node - inference firmware");

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  startSensor();
  startModel();
  printStatus();

  lastSampleMs = millis() - SAMPLE_INTERVAL_MS;  // first reading right away
}

void loop() {
  readSerialCommands();
  if (millis() - lastSampleMs >= SAMPLE_INTERVAL_MS) {
    lastSampleMs += SAMPLE_INTERVAL_MS;
    takeSample();
  }
  delay(10);
}
